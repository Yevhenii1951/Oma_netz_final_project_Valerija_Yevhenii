# ─── DATABASE ────────────────────────────────────
# DATABASE_URL  — pooled connection used by the app at runtime.
# DIRECT_URL    — direct (non-pooled) connection used by Prisma CLI for
#                 migrations. Required by prisma/schema.prisma; in Neon it is
#                 the same host with ?pgbouncer=true removed.
DATABASE_URL="postgresql://oma_user:oma_password@localhost:5432/oma_netz"
DIRECT_URL="postgresql://oma_user:oma_password@localhost:5432/oma_netz"

# ─── NEXTAUTH ────────────────────────────────────
# AUTH_SECRET: generate with `npx auth secret` (min. 32 chars).
AUTH_SECRET="your-super-secret-key-min-32-chars-here"
AUTH_URL="http://localhost:3000"

# ─── PUSHER (real-time chat) ─────────────────────
# Sign up free at https://pusher.com
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# ─── GROQ AI (free tier) ─────────────────────────
# Sign up free at https://console.groq.com
GROQ_API_KEY="your-groq-api-key"

# ─── E-MAIL VERSAND ─────────────────────────────────
# Es wird bewusst kein Provider eingetragen. Mails landen im Server-Log
# (`[mail:log] to=…`), nichts wird zugestellt. Für echten Versand einen
# `MailSender` in src/lib/email-sender.ts implementieren und mit `setSender()`
# registrieren — Aufrufer und Routen bleiben unverändert.

# ─── SUPPORT ─────────────────────────────────────
# Shown on /banned and /impressum so banned users have a way out.
SUPPORT_EMAIL="support@oma-netz.de"

# ─── OPTIONAL: App URL ───────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
